[Unit]
Description=openpibo booting (display, wifi, MCU serial proxy)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/openpibo-os/system
ExecStart=/home/pi/.pyenv/bin/python3 /home/pi/openpibo-os/system/booting.py --port 8080
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
