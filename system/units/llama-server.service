# ############################################################################
# 이 파일은 아직 실물이 아니다. 기기에서 받아 채워야 한다.
#
#   sudo bash /home/pi/openpibo-os/system/units/capture-from-device.sh
#
# 위 스크립트가 기기의 /etc/systemd/system/llama-server.service 를 그대로 떠서
# 이 파일에 덮어쓴다. 그 전까지 이 유닛으로 install.sh 를 돌리면
# **지금 돌고 있는 설정을 잘못된 값으로 덮어쓰게 된다.** install.sh 가 막는다.
#
# 무엇을 모르는가 (docs/plan/01-measurements.md B.1):
#   -c   컨텍스트 길이   ← RAG 청크 상한을 정하는 값. 이걸 모르면 4단계를 못 짠다
#   -t   스레드 수
#   -ngl / --no-mmap / --prompt-cache
#   모델 gguf 경로
#   포트 (50020 으로 알고 있으나 유닛으로 확인 필요)
#
# 추측해서 채우지 말 것. docs/plan/README.md "상시 원칙" 1, 3.
# ############################################################################

[Unit]
Description=llama.cpp server for openpibo (port 50020)
After=network.target

Conflicts=tools.service classify.service

[Service]
Type=simple
User=root
# ExecStart= 는 비워 둔다. 채워지지 않은 유닛으로 서비스가 뜨면
# 잘못된 컨텍스트 길이로 조용히 돌아가는 것보다 안 뜨는 편이 낫다.
ExecStart=/bin/sh -c 'echo "llama-server.service 가 아직 채워지지 않았습니다. system/units/capture-from-device.sh 를 실행하세요." >&2; exit 1'
Restart=no

[Install]
WantedBy=multi-user.target
